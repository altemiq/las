{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "aspire": {
        "type": "local",
        "command": [
          "dotnet",
          "aspire",
          "agent",
          "mcp"
        ]
      },
      "nuget": {
        "type": "local",
        "command": [
          "dotnet",
          "dnx",
          "NuGet.Mcp.Server",
          "--source",
          "https://api.nuget.org/v3/index.json",
          "--yes"
        ]
      }
    }
  }
}