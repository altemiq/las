{
	"mcpServers": {
		"aspire": {
			"type": "stdio",
			"command": "aspire",
			"args": [
				"agent",
				"mcp"
			],
			"tools": [
				"*"
			]
		},
		"nuget": {
			"type": "stdio",
			"command": "dnx",
			"args": [
				"NuGet.Mcp.Server",
				"--source",
				"https://api.nuget.org/v3/index.json",
				"--yes"
			],
			"tools": [
				"*"
			]
		}
	}
}
